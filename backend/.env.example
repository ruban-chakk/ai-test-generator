POSTGRES_DSN=postgresql+asyncpg://ai_test_gen:ai_test_gen_pass@postgres:5432/ai_test_gen
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
PROVIDER_TIMEOUT_SECONDS=30
PROVIDER_MAX_ATTEMPTS=3
AUTH_JWT_SECRET=replace_with_at_least_32_random_bytes
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_ISSUER=ai-test-generator
AUTH_AUDIENCE=ai-test-generator-api
AUTH_COOKIE_NAME=atg_session
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=ai-testgen-embeddings
PINECONE_HOST=https://your-index-host.svc.pinecone.io
PINECONE_NAMESPACE=ai-test-generator
PINECONE_CONTROL_PLANE_URL=https://api.pinecone.io
PINECONE_API_VERSION=2026-07
VECTOR_MAINTENANCE_INTERVAL_SECONDS=21600
VECTOR_MAINTENANCE_REPAIR_MISSING=true
# Keep false until a full namespace audit confirms this app exclusively owns the namespace.
VECTOR_MAINTENANCE_DELETE_ORPHANS=false
VECTOR_CHUNKING_ENABLED=true
VECTOR_CHUNK_TARGET_TOKENS=700
VECTOR_CHUNK_MAX_TOKENS=1000
VECTOR_CHUNK_OVERLAP_TOKENS=80
RAG_CANDIDATE_LIMIT=40
RAG_CONTEXT_LIMIT=8
RAG_SEMANTIC_WEIGHT=0.65
RAG_KEYWORD_WEIGHT=0.25
RAG_SOURCE_WEIGHT=0.10
OUTBOX_BATCH_SIZE=25
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_LOCK_TIMEOUT_SECONDS=300
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=jira-service-account@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_TIMEOUT_SECONDS=30
TEST_REPOSITORY_BASE_URL=https://test-repository.example.com/api/v1
TEST_REPOSITORY_TOKEN=your_test_repository_token
TEST_REPOSITORY_PROVIDER=generic
TEST_REPOSITORY_TIMEOUT_SECONDS=30
# Xray Cloud (TEST_REPOSITORY_PROVIDER=xray_cloud; sync repository is the Jira project key)
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=
XRAY_AUTH_URL=https://xray.cloud.getxray.app/api/v2/authenticate
XRAY_GRAPHQL_URL=https://xray.cloud.getxray.app/api/v2/graphql
# TestRail (TEST_REPOSITORY_PROVIDER=testrail)
TESTRAIL_USERNAME=
TESTRAIL_API_KEY=
TESTRAIL_PROJECT_ID=
TESTRAIL_SECTION_ID=
TESTRAIL_SUITE_ID=
# Zephyr Cloud (TEST_REPOSITORY_PROVIDER=zephyr_cloud; sync repository is the Zephyr project key)
ZEPHYR_BASE_URL=https://api.zephyrscale.smartbear.com/v2
ZEPHYR_API_TOKEN=
EXECUTION_RUNNER_BASE_URL=https://test-runner.example.com/api/v1
EXECUTION_RUNNER_TOKEN=your_execution_runner_token
EXECUTION_RUNNER_TIMEOUT_SECONDS=120
ALERT_WEBHOOK_URL=https://alerts.example.com/hooks/ai-test-generator
ALERT_WEBHOOK_TOKEN=your_alert_webhook_token
ALERT_WEBHOOK_TIMEOUT_SECONDS=10
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10
UPLOAD_MAX_BYTES=2000000
UPLOAD_MAX_REQUIREMENTS=100
UPLOAD_MAX_TEST_CASES=500
MAPPED_UPLOAD_MAX_BYTES=10000000
MAPPED_IMPORT_MAX_RECORDS=20000
MAPPED_JOB_UPLOAD_MAX_BYTES=250000000
MAPPED_JOB_MAX_RECORDS=1000000
MAPPED_JOB_BATCH_SIZE=250
MAPPED_IMPORT_SPOOL_DIR=/tmp/ai-test-generator-imports
HEALTH_PROBE_TIMEOUT_SECONDS=5
OIDC_ENABLED=false
OIDC_ISSUER=https://identity.example.com
OIDC_CLIENT_ID=ai-test-generator
OIDC_CLIENT_SECRET=your_oidc_client_secret
OIDC_AUTHORIZATION_ENDPOINT=https://identity.example.com/authorize
OIDC_TOKEN_ENDPOINT=https://identity.example.com/oauth/token
OIDC_JWKS_URI=https://identity.example.com/.well-known/jwks.json
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback
OIDC_FRONTEND_REDIRECT_URL=http://localhost:5173/requirements
OIDC_ALLOWED_EMAIL_DOMAINS=example.com
OIDC_AUTO_PROVISION=false
OIDC_STATE_COOKIE_NAME=atg_oidc_state
ENVIRONMENT=development
